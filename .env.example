# ===== Required =====
DISCORD_TOKEN=

# ===== Storage =====
# On Railway: attach a Volume mounted at /data and set DATA_DIR=/data (otherwise state is lost on redeploy).
DATA_DIR=data

# ===== Optional: instant slash-command sync to one server while developing =====
# GUILD_ID=123456789012345678

# ===== Spotify (metadata only; audio comes from YouTube/SoundCloud) =====
# Without these the bot falls back to Spotify's public embed pages (works for tracks and
# playlists/albums up to ~100 tracks, but is best-effort).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ===== Audio source =====
# Order in which providers are tried: youtube, soundcloud
SEARCH_PROVIDERS=youtube,soundcloud
# yt-dlp cookies (pick ONE). Path to a Netscape cookies.txt, or the file base64-encoded.
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_B64=
# Optional residential/other proxy for yt-dlp, e.g. http://user:pass@host:port
YTDLP_PROXY=
FFMPEG_PATH=ffmpeg

# ===== Optional Lavalink (leave blank to use yt-dlp + ffmpeg) =====
LAVALINK_URI=
LAVALINK_PASSWORD=

# ===== Behaviour =====
DEFAULT_VOLUME=50
MAX_QUEUE=500
IDLE_TIMEOUT=300
EMPTY_TIMEOUT=120
PAUSE_WHEN_EMPTY=true
AUTOCOMPLETE=true
LOG_LEVEL=INFO
